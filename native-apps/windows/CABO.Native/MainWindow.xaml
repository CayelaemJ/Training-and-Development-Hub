<Window x:Class="CABO.Native.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid x:Name="RootGrid">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="*"/>
  </Grid.RowDefinitions>

  <ProgressBar x:Name="BusyBar" Grid.Row="0" IsIndeterminate="True" Visibility="Collapsed"
               AutomationProperties.Name="Loading from CABO"/>

  <StackPanel Grid.Row="1" Padding="16,8,16,0" Spacing="6">
   <InfoBar x:Name="OfflineBar" Severity="Warning" IsClosable="False" IsOpen="False"
            Title="You are offline"
            Message="CABO needs an internet connection. Nothing is stored for offline use; the app will refresh when you reconnect."/>
   <InfoBar x:Name="StatusBar" IsClosable="True" IsOpen="False"/>
  </StackPanel>

  <!-- Signed-out experience -->
  <ScrollViewer x:Name="SignedOutPanel" Grid.Row="2">
   <StackPanel Padding="32" Spacing="16" MaxWidth="720" HorizontalAlignment="Left">
    <Image Source="ms-appx:///Assets/cabo-256.png" Width="64" Height="64" HorizontalAlignment="Left"
           AutomationProperties.Name="CABO logo"/>
    <TextBlock Text="CABO Learning Hub" Style="{StaticResource TitleTextBlockStyle}"
               AutomationProperties.HeadingLevel="Level1"/>
    <TextBlock TextWrapping="Wrap"
               Text="Learners, teachers, parents and school leaders sign in with their CABO account. Sign-in opens in your web browser so this app never sees your password."/>
    <Button x:Name="SignInButton" Content="Sign in securely" Click="OpenSignIn"
            Style="{StaticResource AccentButtonStyle}" AutomationProperties.Name="Sign in securely in your web browser"/>
    <StackPanel x:Name="TestLoginPanel" Visibility="Collapsed" Spacing="10">
     <TextBlock Text="Isolated demo account only" Style="{StaticResource SubtitleTextBlockStyle}"/>
     <TextBox x:Name="TestUsername" Header="Test username" Text="cabo_test" MaxLength="80"/>
     <PasswordBox x:Name="TestPassword" Header="Test password" MaxLength="200"/>
     <Button x:Name="TestSignInButton" Content="Sign in to test environment" Click="SignInTest"/>
     <TextBlock TextWrapping="Wrap" Text="For fictional learner data only. Test sign-in is disabled in release builds."/>
    </StackPanel>
    <TextBlock Text="Your privacy" Style="{StaticResource SubtitleTextBlockStyle}"
               AutomationProperties.HeadingLevel="Level2"/>
    <TextBlock TextWrapping="Wrap" x:Name="PrivacyText"/>
   </StackPanel>
  </ScrollViewer>

  <!-- Signed-in experience -->
  <NavigationView x:Name="Nav" Grid.Row="2" Visibility="Collapsed"
                  PaneDisplayMode="Auto" IsBackButtonVisible="Collapsed" IsSettingsVisible="False"
                  OpenPaneLength="260" PaneTitle="CABO Learning Hub"
                  SelectionChanged="NavSelectionChanged">
   <NavigationView.PaneFooter>
    <StackPanel Padding="12" Spacing="8">
     <TextBlock x:Name="AccountText" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"/>
     <Button x:Name="RefreshButton" Content="Refresh" Click="RefreshClicked" HorizontalAlignment="Stretch"
             ToolTipService.ToolTip="Refresh (F5)">
      <Button.KeyboardAccelerators>
       <KeyboardAccelerator Key="F5"/>
      </Button.KeyboardAccelerators>
     </Button>
     <Button x:Name="SignOutButton" Content="Sign out" Click="SignOut" HorizontalAlignment="Stretch"/>
    </StackPanel>
   </NavigationView.PaneFooter>
   <ScrollViewer x:Name="ContentScroller" HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto">
    <StackPanel x:Name="ContentHost" Padding="24,16,24,32" Spacing="12" MaxWidth="1100" HorizontalAlignment="Stretch"/>
   </ScrollViewer>
  </NavigationView>
 </Grid>
</Window>
